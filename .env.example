OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
DISCORD_WEBHOOK_URL=
MATCH_THRESHOLD=80
CLOUDFLARE_TUNNEL_TOKEN=

# Optional for localhost-only use.
# For remote access, configure application authentication or a verified
